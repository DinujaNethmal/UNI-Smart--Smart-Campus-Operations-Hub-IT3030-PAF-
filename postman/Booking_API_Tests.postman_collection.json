    { "name": "2. Create Booking - Conflict", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"X-User-Id","value":"1"}], "url": {"raw":"{{baseUrl}}/bookings"}, "body": {"mode":"raw","raw":"{\n  \"resourceId\": 10,\n  \"bookingDate\": \"2026-05-20\",\n  \"startTime\": \"11:00:00\",\n  \"endTime\": \"13:00:00\",\n  \"purpose\": \"Overlapping test\",\n  \"expectedAttendees\": 10\n}"} } },
    { "name": "3. Create Booking - Validation Error", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"X-User-Id","value":"1"}], "url": {"raw":"{{baseUrl}}/bookings"}, "body": {"mode":"raw","raw":"{\n  \"resourceId\": 1,\n  \"bookingDate\": \"2026-05-20\"\n}"} } },
