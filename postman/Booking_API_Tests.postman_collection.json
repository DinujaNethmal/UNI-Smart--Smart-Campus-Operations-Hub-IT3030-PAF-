    { "name": "10. Admin Reject", "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"},{"key":"X-User-Id","value":"99"}], "url": {"raw":"{{baseUrl}}/bookings/2/review"}, "body": {"mode":"raw","raw":"{\n  \"decision\": \"REJECT\",\n  \"reason\": \"Resource under maintenance\"\n}"} } },
